{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prestissimmo",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    "NUXT_CONTACT_TO": "info@prestissimmo.ch",
  },

  "routes": [
    {
      "pattern": "prestissimmo.ch",
      "custom_domain": true,
    },
  ],
  "preview_urls": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prestissimmo",
      "database_id": "ac85fb11-e4e3-4b25-a915-23a08e1ee06c",
      "preview_database_id": "3864968a-c106-44dd-b539-2d8be8995d38",
      "migrations_table": "_hub_migrations",
      "migrations_dir": ".output/server/db/migrations/sqlite/",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "prestissimmo",
      "preview_bucket_name": "prestissimmo-preview",
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "send_metrics": false,
}
